# -----------------------------------------------------------------------
# Hadoop HA configuration for bde2020/docker-hadoop
#
# bde2020 entrypoint conversion:
#   _    -> .
#   __   -> _
#   ___  -> -
#
# Example:
#   HDFS_CONF_dfs_ha_namenodes_hdfs___ha
# becomes:
#   dfs.ha.namenodes.hdfs-ha
#
# IMPORTANT: only use ___ (hyphen) where the REAL Hadoop property name
# actually contains a hyphen (e.g. rpc-address, cluster-id, zk-address).
# Everywhere else a single _ (dot) is correct. A previous version of this
# file used ___ almost everywhere, which silently generated WRONG
# property names (e.g. dfs.ha.automatic-failover-enabled instead of the
# real dfs.ha.automatic-failover.enabled), so Hadoop fell back to
# defaults without any error. Every property below has been checked
# against the actual Hadoop property name.
# -----------------------------------------------------------------------


# =======================================================================
# core-site.xml
# =======================================================================

CORE_CONF_fs_defaultFS=hdfs://hdfs-ha
CORE_CONF_ha_zookeeper_quorum=zoo1:2181,zoo2:2181,zoo3:2181

CORE_CONF_hadoop_http_staticuser_user=root

CORE_CONF_hadoop_proxyuser_hue_hosts=*
CORE_CONF_hadoop_proxyuser_hue_groups=*

CORE_CONF_io_compression_codecs=org.apache.hadoop.io.compress.SnappyCodec


# =======================================================================
# hdfs-site.xml
# =======================================================================

# HDFS HA nameservice
HDFS_CONF_dfs_nameservices=hdfs-ha

# NameNodes in the nameservice
HDFS_CONF_dfs_ha_namenodes_hdfs___ha=nn1,nn2

# NameNode RPC addresses -> dfs.namenode.rpc-address.hdfs-ha.nnN
HDFS_CONF_dfs_namenode_rpc___address_hdfs___ha_nn1=namenode1:9000
HDFS_CONF_dfs_namenode_rpc___address_hdfs___ha_nn2=namenode2:9000

# NameNode HTTP addresses -> dfs.namenode.http-address.hdfs-ha.nnN
HDFS_CONF_dfs_namenode_http___address_hdfs___ha_nn1=namenode1:9870
HDFS_CONF_dfs_namenode_http___address_hdfs___ha_nn2=namenode2:9870

# JournalNode shared edits -> dfs.namenode.shared.edits.dir (dots only, no hyphens)
HDFS_CONF_dfs_namenode_shared_edits_dir=qjournal://journalnode01:8485;journalnode02:8485;journalnode03:8485/hdfs-ha

# JournalNode edits directory -> dfs.journalnode.edits.dir (dots only)
HDFS_CONF_dfs_journalnode_edits_dir=/hadoop/dfs/journalnode

# Client failover provider -> dfs.client.failover.proxy.provider.hdfs-ha
# (dots between failover/proxy/provider; hyphen only in the nameservice id)
HDFS_CONF_dfs_client_failover_proxy_provider_hdfs___ha=org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider

# Fencing -> dfs.ha.fencing.methods (dots only)
HDFS_CONF_dfs_ha_fencing_methods=shell(/bin/true)

# Automatic NameNode failover -> dfs.ha.automatic-failover.enabled
# (hyphen inside "automatic-failover", dot before "enabled")
HDFS_CONF_dfs_ha_automatic___failover_enabled=true

# ZKFC Port -> dfs.ha.zkfc.port (dots only)
HDFS_CONF_dfs_ha_zkfc_port=8019

# DataNode replication
HDFS_CONF_dfs_replication=2

# Disable permissions for development environment -> dfs.permissions.enabled (dots only)
HDFS_CONF_dfs_permissions_enabled=false


# =======================================================================
# yarn-site.xml
# =======================================================================

# Enable ResourceManager HA -> yarn.resourcemanager.ha.enabled (dots only)
YARN_CONF_yarn_resourcemanager_ha_enabled=true

# ResourceManager cluster ID -> yarn.resourcemanager.cluster-id (real hyphen)
YARN_CONF_yarn_resourcemanager_cluster___id=yarn-cluster

# ResourceManagers participating in HA -> yarn.resourcemanager.ha.rm-ids
YARN_CONF_yarn_resourcemanager_ha_rm___ids=rm1,rm2

# ResourceManager hostnames
YARN_CONF_yarn_resourcemanager_hostname_rm1=resourcemanager1
YARN_CONF_yarn_resourcemanager_hostname_rm2=resourcemanager2

# ResourceManager client addresses
YARN_CONF_yarn_resourcemanager_address_rm1=resourcemanager1:8032
YARN_CONF_yarn_resourcemanager_address_rm2=resourcemanager2:8032

# ResourceManager scheduler addresses -> yarn.resourcemanager.scheduler.address.rmN (dots only)
YARN_CONF_yarn_resourcemanager_scheduler_address_rm1=resourcemanager1:8030
YARN_CONF_yarn_resourcemanager_scheduler_address_rm2=resourcemanager2:8030

# ResourceManager ResourceTracker addresses -> yarn.resourcemanager.resource-tracker.address.rmN
# (hyphen inside "resource-tracker", dot before "address")
YARN_CONF_yarn_resourcemanager_resource___tracker_address_rm1=resourcemanager1:8031
YARN_CONF_yarn_resourcemanager_resource___tracker_address_rm2=resourcemanager2:8031

# ResourceManager Web UI -> yarn.resourcemanager.webapp.address.rmN (dots only)
YARN_CONF_yarn_resourcemanager_webapp_address_rm1=resourcemanager1:8088
YARN_CONF_yarn_resourcemanager_webapp_address_rm2=resourcemanager2:8088

# ZooKeeper quorum -> yarn.resourcemanager.zk-address (real hyphen)
YARN_CONF_yarn_resourcemanager_zk___address=zoo1:2181,zoo2:2181,zoo3:2181

# ResourceManager state recovery -> yarn.resourcemanager.recovery.enabled / .store.class (dots only)
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.ZKRMStateStore

# YARN log aggregation -> yarn.log-aggregation-enable (real hyphens)
YARN_CONF_yarn_log___aggregation___enable=true

# NodeManager auxiliary services -> yarn.nodemanager.aux-services (real hyphen)
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle

# NodeManager resources -> yarn.nodemanager.resource.memory-mb / .cpu-vcores
YARN_CONF_yarn_nodemanager_resource_memory___mb=2048
YARN_CONF_yarn_nodemanager_resource_cpu___vcores=2

# Scheduler container allocation -> yarn.scheduler.maximum-allocation-mb / minimum-allocation-mb
YARN_CONF_yarn_scheduler_maximum___allocation___mb=2048
YARN_CONF_yarn_scheduler_minimum___allocation___mb=256

YARN_CONF_yarn_scheduler_capacity_maximum___am___resource___percent=0.5

# =======================================================================
# mapred-site.xml
# =======================================================================

MAPRED_CONF_mapreduce_framework___name=yarn