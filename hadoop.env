# ─────────────────────────────────────────────
# Core
# ─────────────────────────────────────────────
CORE_CONF_fs_defaultFS=hdfs://hdfs-ha
CORE_CONF_hadoop_http_staticuser_user=root
CORE_CONF_ha_zookeeper_quorum=zoo1:2181

# ─────────────────────────────────────────────
# HDFS HA
# ─────────────────────────────────────────────
HDFS_CONF_dfs_webhdfs_enabled=true
HDFS_CONF_dfs_permissions_enabled=false
HDFS_CONF_dfs_namenode_datanode_registration_ip___hostname___check=false

HDFS_CONF_dfs_nameservices=hdfs-ha
HDFS_CONF_dfs_ha_namenodes_hdfs___ha=nn1,nn2
HDFS_CONF_dfs_namenode_rpc-address_hdfs___ha_nn1=namenode1:8020
HDFS_CONF_dfs_namenode_rpc-address_hdfs___ha_nn2=namenode2:8020
HDFS_CONF_dfs_namenode_http-address_hdfs___ha_nn1=namenode1:9870
HDFS_CONF_dfs_namenode_http-address_hdfs___ha_nn2=namenode2:9870
HDFS_CONF_dfs_namenode_shared_edits_dir=qjournal://journalnode1:8485;journalnode2:8485;journalnode3:8485/hdfs-ha
HDFS_CONF_dfs_client_failover_proxy_provider_hdfs___ha=org.apache.hadoop.hdfs.server.namenode.ha.ConfiguredFailoverProxyProvider
HDFS_CONF_dfs_ha_automatic___failover_enabled=true
HDFS_CONF_dfs_ha_fencing_methods=shell(/bin/true)
HDFS_CONF_dfs_journalnode_edits_dir=/hadoop/dfs/journalnode

# ─────────────────────────────────────────────
# YARN HA
# ─────────────────────────────────────────────
YARN_CONF_yarn_resourcemanager_ha_enabled=true
YARN_CONF_yarn_resourcemanager_cluster___id=yarn-ha
YARN_CONF_yarn_resourcemanager_ha_rm___ids=rm1,rm2
YARN_CONF_yarn_resourcemanager_hostname_rm1=resourcemanager1
YARN_CONF_yarn_resourcemanager_hostname_rm2=resourcemanager2
YARN_CONF_yarn_resourcemanager_webapp_address_rm1=resourcemanager1:8088
YARN_CONF_yarn_resourcemanager_webapp_address_rm2=resourcemanager2:8088
YARN_CONF_yarn_resourcemanager_zk___address=zoo1:2181
YARN_CONF_yarn_resourcemanager_recovery_enabled=true
YARN_CONF_yarn_resourcemanager_store_class=org.apache.hadoop.yarn.server.resourcemanager.recovery.ZKRMStateStore
YARN_CONF_yarn_nodemanager_aux___services=mapreduce_shuffle
YARN_CONF_yarn_log___aggregation__enable=true
